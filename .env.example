# Run `npm run init:env` to generate private values. Never commit a real .env.
APP_KEY=
SETUP_TOKEN=

APP_URL=http://localhost:8888
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8888
LANDING_ENABLED=false
REGISTRATION_ENABLED=false

# Optional tagged GHCR images. Leave empty to build local images.
HOPYA_API_IMAGE=
HOPYA_WEB_IMAGE=

# Optional password recovery and email automation.
SMTP_URL=
SMTP_FROM=

# Optional S3-compatible attachment storage. Filesystem storage uses the private ./data directory.
STORAGE_DRIVER=filesystem
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Optional OpenID Connect sign-in.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUTO_PROVISION=false
OIDC_ALLOW_INSECURE_HTTP=false

# Optional AI provider: openai, anthropic, google, or openai-compatible.
AI_PROVIDER=
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_MAX_OUTPUT_TOKENS=2048

# Database engine. SQLite is the zero-configuration default.
# To use the optional Compose Postgres service, set COMPOSE_PROFILES=postgres
# and DB_CONNECTION=pg after generating the private environment file.
COMPOSE_PROFILES=
DB_CONNECTION=sqlite
DATABASE_URL=
POSTGRES_DB=hopya
POSTGRES_USER=hopya
POSTGRES_PASSWORD=

# Optional MCP mutation tools for stdio and administrator-enabled SSE. Keep false unless clients require human approval for every write.
HOPYA_MCP_ALLOW_WRITES=false

# Used by `npm run dev`; Docker Compose sets these internally.
HOST=0.0.0.0
API_PORT=3333
PORT=4321
DATA_DIR=/data
TRUST_PROXY_HOPS=0
