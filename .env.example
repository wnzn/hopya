# Run `npm run init:env` to generate private values. Never commit a real .env.
APP_KEY=
SETUP_TOKEN=

APP_URL=http://localhost:8080
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
LANDING_ENABLED=true
REGISTRATION_ENABLED=false

# Optional password recovery and email automation.
SMTP_URL=
SMTP_FROM=

# Optional S3-compatible attachment storage. Filesystem storage uses the Docker volume.
STORAGE_DRIVER=filesystem
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Optional OpenID Connect sign-in.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUTO_PROVISION=false
OIDC_ALLOW_INSECURE_HTTP=false

# Optional AI provider: openai, anthropic, google, or openai-compatible.
AI_PROVIDER=
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_MAX_OUTPUT_TOKENS=2048

# Used by `npm run dev`; Docker Compose sets these internally.
HOST=0.0.0.0
API_PORT=3333
PORT=4321
DATA_DIR=/data
TRUST_PROXY_HOPS=0
