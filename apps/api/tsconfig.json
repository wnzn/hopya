{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "outDir": "build",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["app/**/*.ts", "bin/**/*.ts", "config/**/*.ts", "start/**/*.ts", "tests/**/*.ts", "adonisrc.ts"],
  "exclude": ["build", "node_modules"]
}
