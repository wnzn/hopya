{
  "name": "@hopya/api",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node ace.js migration:run --no-schema-generate && tsx watch bin/server.ts",
    "start": "node build/bin/console.js migration:run --no-schema-generate --force && node build/bin/server.js",
    "mcp": "node build/bin/mcp.js",
    "ace": "node ace.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/run.ts"
  },
  "dependencies": {
    "@adonisjs/core": "^7.6.0",
    "@adonisjs/lucid": "^22.4.2",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^13.0.3",
    "effect": "^4.0.6",
    "knex": "^3.3.0",
    "luxon": "^3.7.2",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.2.1",
    "openid-client": "^6.8.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@japa/assert": "^4.2.0",
    "@japa/runner": "^5.4.0",
    "@types/luxon": "^3.7.6",
    "@types/nodemailer": "^7.0.1",
    "tsx": "^4.23.15",
    "youch": "^4.1.0"
  }
}
