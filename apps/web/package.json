{
  "name": "@hopya/web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 ASTRO_DEV_BACKGROUND=0 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build && node -e \"require('node:fs').copyFileSync('src/landing.json', 'dist/server/landing.json')\"",
    "start": "node dist/server/entry.mjs",
    "typecheck": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "tsx --test src/lib/*.test.ts",
    "test:browser": "playwright test --project=chromium",
    "test:browser:all": "playwright test",
    "test:live": "tsx tests/live-smoke.ts"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "@astrojs/react": "^6.0.6",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@xyflow/react": "^12.12.0",
    "astro": "^7.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "~1.58.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright-core": "~1.58.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
